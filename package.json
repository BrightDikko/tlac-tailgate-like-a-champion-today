{
  "name": "tlac",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start:mock": "EXPO_PUBLIC_API_MODE=mock expo start --clear",
    "start:remote": "EXPO_PUBLIC_API_MODE=remote EXPO_PUBLIC_API_BASE_URL=https://ministries-generic-inputs-spotlight.trycloudflare.com/api/v1 expo start --clear",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:web": "expo start --web --clear",
    "build:web:prod": "EXPO_PUBLIC_API_MODE=remote EXPO_PUBLIC_API_BASE_URL=https://ministries-generic-inputs-spotlight.trycloudflare.com/api/v1 npx expo export --platform web --clear",
    "preview:web": "rm -rf .web-preview && mkdir -p .web-preview/tlac-tailgate-like-a-champion-today && cp -R dist/. .web-preview/tlac-tailgate-like-a-champion-today && npx serve .web-preview",
    "deploy:web": "npm run build:web:prod && npx gh-pages -d dist -t",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@reduxjs/toolkit": "^2.11.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
